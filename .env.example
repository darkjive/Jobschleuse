# OpenAI-kompatibler LLM-Endpoint (GLM, Claude via Proxy, etc.)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional, Defaults siehe config.py
# DB_PATH=data/jobs.db
# OUT_DIR=out
# TEMPLATE_PATH=templates/beispiel.html
# PROFILE_PATH=profile.yaml
# CBKS_INBOX=/home/a/Dev/cbks/data/inbox

# Passwort für /api/* per HTTP Basic Auth. Leer lassen für Loopback-Betrieb.
# EMPFOHLEN, sobald `jobs serve --host 0.0.0.0` (z. B. für Handy-Zugriff)
# in einem Netz läuft, das nicht 100% vertrauenswürdig ist.
# JOBS_WEB_TOKEN=
